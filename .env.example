# Only fill these on the deployment host. This file contains no usable keys.
CHALLENGE_API_KEY=
OPENAI_API_KEY=
# Disclosed GPT provider: CloseAI third-party OpenAI-compatible relay.
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
PROFILE_LLM_API_KEY=${OPENAI_API_KEY}
PROFILE_LLM_BASE_URL=${OPENAI_BASE_URL}
CHALLENGE_PROFILE_MODEL=gpt-4o-mini
QIAN_WEN_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
MEMORY_RERANK_API_KEY=${DEEPSEEK_API_KEY}
MEMORY_RERANK_BASE_URL=https://api.deepseek.com
MEMORY_RERANK_MODEL=deepseek-chat
MEMORY_RERANK_ENABLED=true
MEMORY_RERANK_CANDIDATES=100
MEMORY_RETRIEVAL_MODE=hybrid
MEMORY_SOURCE_RECORD_INDEX=true
MEMORY_HYBRID_FUSION=legacy
MEMORY_EVIDENCE_COVERAGE=false
MEMORY_CREDENTIAL_FILTER=false
# Set your public DNS name before enabling compose.https.yaml.
MEMORY_PUBLIC_HOST=
